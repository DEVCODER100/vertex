# Copy this file to ".env" and fill in the values. Never share or commit ".env".

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (Developer Mode on -> right-click the server icon -> Copy Server ID)
GUILD_ID=

# Channel for greetings (right-click the channel -> Copy Channel ID). Leave empty to use the server's system channel.
WELCOME_CHANNEL_ID=

# Channel for automatic quiz drops. Leave EMPTY to keep automatic drops off.
QUIZ_CHANNEL_ID=

# Say goodbye when someone leaves? true / false
SEND_GOODBYE=false
